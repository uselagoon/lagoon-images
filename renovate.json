{
  "baseBranchPatterns": [
    "main",
    "testing/alpine_next",
    "testing/renovate"
  ],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "mergeConfidence:all-badges",
    "config:recommended",
    ":disableRateLimiting"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "separateMultipleMajor": true,
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "pecl install -f apcu-(?<currentValue>.*?) ",
        "install-php-extensions apcu-(?<currentValue>.*?) ",
        "pie install apcu/apcu:(?<currentValue>.*?) "
      ],
      "depNameTemplate": "krakjoe/apcu",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "pecl install -f imagick-(?<currentValue>.*?) ",
        "install-php-extensions imagick-(?<currentValue>.*?) ",
        "pie install imagick/imagick:(?<currentValue>.*?) "
      ],
      "depNameTemplate": "Imagick/imagick",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "pecl install -f redis-(?<currentValue>.*?) ",
        "install-php-extensions redis-(?<currentValue>.*?) ",
        "pie install phpredis/phpredis:(?<currentValue>.*?) "
      ],
      "depNameTemplate": "phpredis/phpredis",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "pecl install -f xdebug-(?<currentValue>.*?) ",
        "install-php-extensions xdebug-(?<currentValue>.*?) ",
        "pie install xdebug/xdebug:(?<currentValue>.*?) "
      ],
      "depNameTemplate": "xdebug/xdebug",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "pecl install -f yaml-(?<currentValue>.*?) ",
        "install-php-extensions yaml-(?<currentValue>.*?) ",
        "pie install pecl/yaml:(?<currentValue>.*?) "
      ],
      "depNameTemplate": "php/pecl-file_formats-yaml",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "ENV BLACKFIRE_VERSION=(?<currentValue>.*?)\n"
      ],
      "depNameTemplate": "blackfireio/docker",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "ENV NEWRELIC_VERSION=(?<currentValue>.*?)\n"
      ],
      "depNameTemplate": "newrelic/newrelic-php-agent",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "curl.*https://github.com/(?<depName>.*?)/releases/download/(?<currentValue>.*?)/.*.phar.*\n"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/"
      ],
      "matchStrings": [
        "php.*--require=(?<depName>.*?):(?<currentValue>.*?)\\s.*\n"
      ],
      "datasourceTemplate": "packagist"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)nginx/Dockerfile$/"
      ],
      "matchStrings": [
        "ENV OPENRESTY_VERSION=(?<currentValue>[\\d.]+)\n"
      ],
      "depNameTemplate": "openresty/openresty",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "regex:^(\\d)\\.(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)valkey/.*\\.Dockerfile$/"
      ],
      "matchStrings": [
        "FROM valkey/valkey:(?<currentValue>[\\d.]+-alpine[\\d.]+)"
      ],
      "depNameTemplate": "valkey/valkey",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-alpine(?<build>\\d+)\\.(?<revision>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)varnish/6\\.Dockerfile$/"
      ],
      "matchStrings": [
        "ENV VARNISH_VERSION=(?<currentValue>[\\d.]+)\n"
      ],
      "depNameTemplate": "varnish",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "enabled": true,
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "matchPackageNames": [
        "krakjoe/apcu"
      ],
      "extractVersion": "^v(?<version>.*)$"
    },
    {
      "enabled": true,
      "matchDatasources": [
        "github-releases",
        "github-tags",
        "packagist"
      ],
      "matchPackageNames": [
        "newrelic/newrelic-php-agent"
      ],
      "extractVersion": "^v(?<version>.*)$",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+).(?<build>\\d+)$"
    },
    {
      "enabled": true,
      "matchDatasources": [
        "github-releases",
        "github-tags",
        "packagist"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "Imagick/imagick",
        "phpredis/phpredis",
        "xdebug/xdebug",
        "php/pecl-file_formats-yaml",
        "composer/composer",
        "drush/drush",
        "hechoendrupal/drupal-console-launcher",
        "drush-ops/drush-launcher",
        "blackfireio/docker"
      ]
    },
    {
      "enabled": false,
      "groupName": "Disable PHP package/extension major updates",
      "matchDatasources": [
        "github-releases",
        "github-tags",
        "packagist"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "krakjoe/apcu",
        "Imagick/imagick",
        "phpredis/phpredis",
        "xdebug/xdebug",
        "php/pecl-file_formats-yaml",
        "composer/composer",
        "drush/drush",
        "hechoendrupal/drupal-console-launcher",
        "drush-ops/drush-launcher",
        "blackfireio/docker"
      ]
    },
    {
      "enabled": false,
      "groupName": "Disable VARNISH_VERSION major updates - varnish/6.Dockerfile stays on v6",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "varnish"
      ]
    },
    {
      "groupName": "valkey",
      "matchFileNames": [
        "images/valkey/**"
      ]
    },
    {
      "enabled": false,
      "groupName": "Disable valkey major updates - one Dockerfile per pinned major",
      "matchDepNames": [
        "valkey/valkey"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "enabled": true,
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "openresty/openresty"
      ],
      "extractVersion": "^v(?<version>.*)$",
      "versioning": "regex:^(\\d)\\.(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
